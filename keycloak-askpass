#!/usr/bin/env bash
prompt="$1"
url=$(grep -oE 'https://[^ ]+' <<<"$prompt")

if [[ -n $url ]]; then
    case $(uname -s) in 
      "Linux" )
         xdg-open "$url" >/dev/null 2>&1 &
      ;;
      "Darwin" )
         open "$url" >/dev/null 2>&1 &
      ;;
    * )
         echo "Currently only supported on Linux and Mac, sorry Windows users..."
         exit 1
    esac
    printf 'Keycloak login can be completed in the browser, then press ENTER ' "$url" >/dev/tty
    read -r </dev/tty
    echo ""          # the empty answer is the "press ENTER"
else
    echo "Not sure this is a keycloak auth, bye"
fi
